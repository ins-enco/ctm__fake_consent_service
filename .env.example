# CTM Fake Consent Service Configuration

# CTM API Configuration  
CTM_API_URL="http://localhost:3000"

# Application Configuration
APPNAME="CTM Fake Consent Service"
BASE_URL="http://localhost:3000"

# Optional: Docker Configuration (for containerized deployment)
HOST_PORT=3000
CONTAINER_NAME="ctm-fake-consent-service"

# Production Configuration (Optional)
NODE_ENV="production"

# DB Patch Tool (admin/db-tools) — writes directly to the CTM database.
# Leave CTM_DB_PASS / DB_PATCH_TOOL_KEY empty to keep the tool disabled.
CTM_DB_HOST="db.example.internal"
CTM_DB_PORT="3306"
CTM_DB_NAME="ctm"
CTM_DB_USER="ctm_user"
CTM_DB_PASS=""
DB_PATCH_TOOL_KEY=""
# Testing shortcut: grant broker consent when the fake login succeeds, instead
# of on approval as the real flow does. Requires CTM_DB_* above. Off by default.
CONSENT_AUTOPATCH_ON_LOGIN="false"

# Where the Standard (ConsentType=1) journey returns the follower so the pending
# onboarding resumes — the CTM portal, not this service. Mirrors the backend's
# Docusign:DefaultReturnUrl (e.g. http://localhost:5173/kyc/docusign-return).
# Leave empty to fall back to the local dev-test dashboard.
CONSENT_RETURN_URL=""
